# ============================================================
# Garmin 认证配置（二选一，或设为 auto 自动优先官方 Personal API）
# ============================================================
# 模式: auto | personal_api | connect_session
GARMIN_AUTH_MODE=auto
# 区域: cn (connect.garmin.cn) | global (connect.garmin.com)
GARMIN_REGION=cn

# [方式 1] 官方原生 Personal API（推荐优先测试）
# 中国区获取地址: https://connect.garmin.cn/app/settings/personalApiToken
GARMIN_PERSONAL_API_KEY=
# 可选：自定义端点（默认按 GARMIN_REGION 自动选择 personal.connectapi.garmin.cn / .com）
GARMIN_BASE_URL=

# [方式 2] 佳明会话登录兜底（当 .cn 官方 Personal API 遇到 HTTP 526 故障时使用）
GARMIN_EMAIL=
GARMIN_PASSWORD=
# 可选：本地导出的 Session Token JSON（可免除 GitHub Actions 中的 MFA 二次验证）
GARMIN_SESSION_JSON=

# ============================================================
# 手机通知推送（按需填写一个或多个，留空则跳过）
# ============================================================
FEISHU_WEBHOOK=
WECOM_WEBHOOK=
DINGTALK_WEBHOOK=
SERVERCHAN_KEY=
BARK_URL=

# 部署后的看板访问链接（用于推送消息里的跳转按钮，GitHub Actions 会自动填充）
DASHBOARD_URL=

# ============================================================
# 独立服务器全栈打卡 & 日记 API 配置
# ============================================================
# 手机端提交打卡、训练日记和手动同步 Garmin 的操作口令（强烈建议设置）
COACH_ADMIN_TOKEN=
# Nginx 静态网站同步输出目录（如 /var/www/garmin-coach），留空则仅输出到 dist/
PUBLISH_DIR=
PORT=3001
